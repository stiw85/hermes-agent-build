{
  "name": "hermes-trader-desktop",
  "productName": "Hermes Trader",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for Hermes Trader, in the Herald OS deep-blue glass style.",
  "license": "MIT",
  "author": "stiw85",
  "type": "module",
  "main": "dist/electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,yellow \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5190 && node scripts/bundle-electron.mjs --dev && cross-env HT_DEV_SERVER=http://127.0.0.1:5190 electron .",
    "build": "vite build && node scripts/bundle-electron.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@tabler/icons-react": "3.46.0",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "dev.stiw85.hermestrader",
    "productName": "Hermes Trader",
    "artifactName": "hermes-trader-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "category": "Finance",
      "icon": "build/icon.png",
      "executableName": "hermes-trader-desktop",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "desktop": {
        "entry": {
          "Name": "Hermes Trader",
          "Comment": "Self-improving trading bot",
          "Categories": "Finance;Office;"
        }
      }
    }
  }
}
